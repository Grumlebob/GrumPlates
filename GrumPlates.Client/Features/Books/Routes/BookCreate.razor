@page "/books/new"
@attribute [Authorize]
@implements IDisposable

@inject IBooksApi Books
@inject UserBookcaseState UserBooks
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject ILogger<BookCreate> Logger

<PageTitle>Add a book</PageTitle>

<main class="mx-auto max-w-2xl" data-testid="book-create-page">
    <a class="text-sm font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" href="/books">← Back to your books</a>
    <section class="mt-5 rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
        <h1 class="text-2xl font-bold text-gray-900">Add a book</h1>
        <p class="mt-2 text-sm text-gray-600">Add a book to your private list.</p>
        <div class="mt-6">
            <BookForm Model="_model" SubmitLabel="Save book" CancelHref="/books" Error="@_error" IsBusy="_saving" OnValidSubmit="SaveAsync" />
        </div>
    </section>
</main>

@code {
    private BookFormModel _model = new();
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _activeOperation;
    private string? _loadedUserId;
    private bool _saving;
    private bool _disposed;
    private string? _error;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        ApplyIdentityChange(BookUserIdentity.GetUserKey(authenticationState.User));
    }

    private async Task SaveAsync(BookFormModel model)
    {
        if (!RendererInfo.IsInteractive || _saving || _disposed || string.IsNullOrWhiteSpace(_loadedUserId))
        {
            return;
        }

        var userId = _loadedUserId;
        var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _activeOperation = operation;
        _saving = true;
        _error = null;
        try
        {
            if (!await IsCurrentUserAsync(userId, operation))
            {
                return;
            }

            var created = await Books.CreateAsync(new CreateBookRequest
            {
                Title = model.Title.Trim(),
                Author = NormalizeOptional(model.Author),
                Url = NormalizeOptional(model.Url)
            }, operation.Token);

            if (!await IsCurrentUserAsync(userId, operation))
            {
                return;
            }

            await UserBooks.LoadForCurrentUserAsync(operation.Token);
            if (!await IsCurrentUserAsync(userId, operation))
            {
                return;
            }

            Nav.NavigateTo($"/books/{created.Id}");
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            if (IsCurrentOperation(operation))
            {
                Logger.LogWarning(ex, "Book creation failed.");
                _error = "The book could not be saved. Your entries are still here; please try again.";
            }
        }
        finally
        {
            if (ReferenceEquals(_activeOperation, operation))
            {
                _activeOperation = null;
                _saving = false;
            }

            operation.Dispose();
        }
    }

    private bool IsCurrentOperation(CancellationTokenSource operation) =>
        !operation.IsCancellationRequested &&
        ReferenceEquals(_activeOperation, operation);

    private async Task<bool> IsCurrentUserAsync(string expectedUserId, CancellationTokenSource operation)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!IsCurrentOperation(operation))
        {
            return false;
        }

        var userId = BookUserIdentity.GetUserKey(authenticationState.User);
        if (string.Equals(expectedUserId, userId, StringComparison.Ordinal))
        {
            return true;
        }

        ApplyIdentityChange(userId);
        return false;
    }

    private void ApplyIdentityChange(string? userId)
    {
        if (string.Equals(userId, _loadedUserId, StringComparison.Ordinal))
        {
            return;
        }

        _loadedUserId = userId;
        _model = new BookFormModel();
        _error = null;
        _saving = false;
        CancelActiveOperation();
    }

    private void CancelActiveOperation()
    {
        var operation = _activeOperation;
        _activeOperation = null;
        if (operation is not null)
        {
            operation.Cancel();
        }
    }

    private static string? NormalizeOptional(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        CancelActiveOperation();
        _lifetime.Dispose();
    }
}
